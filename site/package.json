{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "content:check": "tsx scripts/validate-content.ts",
    "palette:check": "tsx scripts/validate-palette.ts",
    "brain:check": "tsx ../scripts/brain-check.ts",
    "brain:sync-github": "tsx ../scripts/brain-sync-github.ts",
    "boundary:check": "tsx scripts/validate-server-boundaries.ts",
    "assets:check": "tsx scripts/check-3d-assets.ts",
    "immersive:check": "tsx scripts/validate-immersive-build.ts",
    "assets:optimize": "tsx scripts/optimize-3d-asset.ts",
    "assets:verify-variant": "tsx scripts/optimize-3d-asset.ts --verify",
    "test:unit": "tsx --test src/tests/*.test.ts",
    "test": "pnpm test:unit && pnpm brain:check && pnpm content:check && pnpm palette:check && pnpm boundary:check && pnpm assets:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:prebuild": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm verify:prebuild && pnpm build && pnpm immersive:check"
  },
  "dependencies": {
    "@openrouter/sdk": "0.13.65",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.4.1",
    "@gltf-transform/extensions": "4.4.1",
    "@gltf-transform/functions": "4.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.1",
    "draco3dgltf": "1.5.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.2.0",
    "prettier": "^3.9.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
