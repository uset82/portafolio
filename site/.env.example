# Server-only. Required only when the CC AI server route is implemented and tested.
# GOTCHA: a real OS environment variable of the same name WINS over .env.local in
# Next.js. A stale user-scope OPENROUTER_API_KEY on Windows made every request
# fail with 401 "User not found" while .env.local held a valid key. Verify with
# `[Environment]::GetEnvironmentVariable('OPENROUTER_API_KEY','User')` and clear
# it with `setx OPENROUTER_API_KEY ""` (then reopen the terminal) if it is set.
OPENROUTER_API_KEY=

# Server-only model policy mode. Production fails closed unless paid named models are configured.
CC_AI_MODE=prototype

# Prototype primary and ordered comma-separated fallbacks. openrouter/free selects a variable free model.
# Extra named models use the same OPENROUTER_API_KEY. The value is the OpenRouter
# slug, not a second secret. Example: stealth/ox-alpha with the free router as backup.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=

# Production primary and ordered comma-separated fallbacks. Free routes are rejected in production mode.
OPENROUTER_PRODUCTION_MODEL=
OPENROUTER_PRODUCTION_FALLBACK_MODELS=

# Server-only kill switch. Keep false until public knowledge, provider policy, and abuse controls pass their gates.
CC_AI_ENABLED=false

# Server-only specialist adapters at /api/agent and gated visitor ANA at /api/ana.
# Keep false until equivalent safety gates pass. This does not replace CC AI.
ANA_SPECIALISTS_ENABLED=false

# Server-only internal ANA debug dashboard at /ana/debug. Keep false in public deploys.
# This is not a visitor feature and does not replace CC AI.
ANA_DEBUG_ENABLED=false

# Server-only 32-byte key as 64 hex characters. Required only if ANA user memory is persisted.
# Phase 13 keeps memory in-process; leave empty.
ANA_MEMORY_KEY=

# Optional HTTP engines for Phase 6 specialists. Leave empty to keep those agents unavailable.
ASTRAEA_API_URL=
STRUDEL_API_URL=

# Server-only initial per-instance limits. A shared durable limiter is still required before multi-instance activation.
CC_AI_RATE_LIMIT=6
CC_AI_RATE_WINDOW_SECONDS=60
CC_AI_MAX_CONCURRENT=4

# Provider response budget in milliseconds (max 180000). Defaults to 180000 in
# prototype mode so stealth/ox-alpha can finish at max reasoning effort,
# and 12000 in production mode.
CC_AI_TIMEOUT_MS=

# Public canonical origin used for metadata after preview/production hosting is approved.
# The server also sends this origin as OpenRouter's HTTP-Referer with the approved CC AI title.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Arcade -----------------------------------------------------------------
# Public origin of the My Football Game service (Tier B: its own deployment,
# not part of this build). While this is empty the arcade shows the game as
# waiting on hosting instead of rendering a broken frame. Origin only, no path.
# Example: https://my-football-game.up.railway.app
NEXT_PUBLIC_FOOTBALL_GAME_URL=

# --- Support ----------------------------------------------------------------
# Public Buy Me a Coffee page. While this is empty the tip card is not rendered
# at all, so no guessed handle is ever published as a real link.
# Example: https://buymeacoffee.com/<your-handle>
NEXT_PUBLIC_BUYMEACOFFEE_URL=
