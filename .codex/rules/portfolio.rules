# Project-local execution policy. These rules apply when this trusted project
# requests commands outside the sandbox. Human delivery rules live in rules.md.

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Do not rewrite shared history; push a normal branch and open a reviewable pull request instead.",
    match = [
        "git push --force",
        "git push --force origin main",
    ],
    not_match = [
        "git push origin main",
    ],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Preserve user work; inspect changes and use a targeted, recoverable operation instead.",
    match = [
        "git reset --hard",
        "git reset --hard HEAD~1",
    ],
    not_match = [
        "git reset --soft HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "clean", ["-f", "-fd", "-df", "-fdx", "-xdf"]],
    decision = "forbidden",
    justification = "Do not delete untracked project files; enumerate exact targets and use a recoverable operation.",
    match = [
        "git clean -f",
        "git clean -fd",
        "git clean -fdx",
    ],
    not_match = [
        "git clean -n",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Pushing changes affects the shared GitHub repository and requires explicit confirmation.",
    match = [
        "git push",
        "git push origin main",
        "git push -u origin feature/portfolio-shell",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", ["create", "merge"]],
    decision = "prompt",
    justification = "Creating or merging a pull request changes shared GitHub state and requires confirmation.",
    match = [
        "gh pr create --draft",
        "gh pr merge 12 --squash",
    ],
    not_match = [
        "gh pr view 12",
        "gh pr list",
    ],
)

prefix_rule(
    pattern = ["npm", "publish"],
    decision = "prompt",
    justification = "Package publication is an external release action and requires confirmation.",
    match = [
        "npm publish",
        "npm publish --access public",
    ],
)

prefix_rule(
    pattern = ["npx", ["netlify", "vercel", "wrangler"]],
    decision = "prompt",
    justification = "Deployment commands may create or modify public infrastructure and require confirmation.",
    match = [
        "npx netlify deploy --prod",
        "npx vercel --prod",
        "npx wrangler deploy",
    ],
)
